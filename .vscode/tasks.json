{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Emulador: iniciar flutter_pixel",
            "type": "shell",
            "command": "flutter emulators --launch flutter_pixel",
            "problemMatcher": []
        },
        {
            "label": "Backend: iniciar API Flask",
            "type": "shell",
            "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
            "args": ["run.py"],
            "options": { "cwd": "${workspaceFolder}/backend" },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Backend: configurar PostgreSQL",
            "type": "shell",
            "command": "powershell",
            "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/backend/setup_postgres.ps1"],
            "problemMatcher": []
        },
        {
            "label": "Backend: cargar datos semilla",
            "type": "shell",
            "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
            "args": ["seed.py"],
            "options": { "cwd": "${workspaceFolder}/backend" },
            "problemMatcher": []
        },
        {
            "label": "Backend: aplicar migraciones",
            "type": "shell",
            "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
            "args": ["migrate.py"],
            "options": { "cwd": "${workspaceFolder}/backend" },
            "problemMatcher": []
        },
        {
            "label": "Backend: pruebas (pytest)",
            "type": "shell",
            "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
            "args": ["-m", "pytest", "-q"],
            "options": { "cwd": "${workspaceFolder}/backend" },
            "group": "test",
            "problemMatcher": []
        }
    ]
}
